# ─────────────────────────────────────────────────────────────
#  Environment variables — copy this file to .env and replace "..." with your API keys.
# ─────────────────────────────────────────────────────────────

# LLM provider API key
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=...

# Tavily API key — used by the web_search tool (https://tavily.com).
TAVILY_API_KEY=...

# ─────────────────────────────────────────────────────────────
#  OpenTelemetry — entirely optional.
#
#  The agent runs exactly the same without any of this. You only need it
#  if you want traces and metrics in a collector (Jaeger, Grafana, etc.).
#  Token usage and cost are already printed in the terminal after every
#  turn, no collector required.
#
#  Export is off unless you pass --otel on the command line; these
#  variables only tune where and what it sends.
# ─────────────────────────────────────────────────────────────

# OTLP/gRPC endpoint. Defaults to localhost:4317.
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# Service name shown in the collector. Defaults to "coding-agent".
# OTEL_SERVICE_NAME=coding-agent

# Record prompts, responses, and tool arguments as span events.
# Off by default: no prompt or file content ever leaves the process.
# Only turn this on if you trust whoever can read your traces.
# OTEL_GENAI_CAPTURE_MESSAGE_CONTENT=true
